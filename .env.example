# Copy to .env and fill in. .env is git-ignored.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# Optional: fixed secret for login cookies (a random one is generated otherwise)
SECRET_KEY=

# Email (appointment confirmations and reminders). Leave SMTP_HOST empty to save
# emails as .eml files in ./outbox instead of sending them.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASSWORD=<16-character app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
# Link used in emails
APP_BASE_URL=http://localhost:8000
# Hours before an appointment to send reminders
REMINDER_HOURS=24,2
